# Copy to .env and keep real credentials out of source control. Restart the server after changes.
# Google OAuth: use the same OAuth Web client ID in both variables.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email confirmation (needed for automatic college verification by email).
# APP_URL is the public address of the website; it is the base of the link in the confirmation email.
# With `npm run dev` use http://localhost:5173. RESEND_API_KEY + MAIL_FROM send real mail through resend.com
# (MAIL_FROM must be an address on a domain you verified there). Without them, outside production, the link is
# printed in the server console instead.
APP_URL=
RESEND_API_KEY=
MAIL_FROM=

# Optional OpenAI-compatible AI provider (server-side only). Without a key, UniLink uses built-in guidance.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional server settings
# Use 127.0.0.1 for local-only use; hosted services should bind to all interfaces.
HOST=0.0.0.0
PORT=3001
# CAMPUSCONNECT_DB=/absolute/path/to/campusconnect.db
