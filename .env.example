# Copy to .env and keep real credentials out of source control. Restart the server after changes.
# Optional OpenAI-compatible AI provider (server-side only). Without a key, UniLink uses built-in guidance.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional server settings
# Use 127.0.0.1 for local-only use; hosted services should bind to all interfaces.
HOST=0.0.0.0
PORT=3001
# CAMPUSCONNECT_DB=/absolute/path/to/campusconnect.db

# Optional paths (default to folders inside ./database)
# CAMPUSCONNECT_UPLOADS=/absolute/path/to/uploads
# CAMPUSCONNECT_LOGOS=/absolute/path/to/logos

# Maximum upload size in MB (default 50)
# MAX_UPLOAD_MB=50

# AI_API_KEY can also be supplied as OPENAI_API_KEY; either one enables the assistant.
